{
  "name": "nestjs",
  "version": "0.0.1",
  "description": "Basic Nest Application using AWS",
  "author": "Alessandro Traversi",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run --config ./test/config/vitest.config.ts",
    "test:watch": "vitest --config ./test/config/vitest.config.ts",
    "test:ui": "vitest --ui --watch --config ./test/config/vitest.config.ts",
    "test:cov": "vitest run --config ./test/config/vitest.config.ts --coverage",
    "test:debug": "vitest --config ./test/config/vitest.config.ts --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./test/config/vitest.config.e2e.ts",
    "docker:build": "docker compose -f docker/docker-compose.yml build",
    "docker:up": "docker compose -f docker/docker-compose.yml up --build",
    "docker:down": "docker compose -f docker/docker-compose.yml down -v",
    "docker:logs": "docker compose -f docker/docker-compose.yml logs -f",
    "tf:dev:init": "terraform -chdir=terraform/environments/dev init",
    "tf:dev:plan": "terraform -chdir=terraform/environments/dev plan",
    "tf:dev:apply": "terraform -chdir=terraform/environments/dev apply",
    "tf:dev:destroy": "terraform -chdir=terraform/environments/dev destroy"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1135.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.1",
    "@nestjs/observe": "^0.2.3",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "@nestjs/terminus": "^12.0.0",
    "helmet": "^8.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "^0.2.6",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "@vitest/ui": "^4.1.11",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  }
}
