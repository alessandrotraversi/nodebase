# --- App ---
PORT=3000

# --- Secrets Manager (Floci locally, real AWS in prod) ---
# https://floci.io
#
# When running via `docker compose up`, these are already wired to the
# `floci` service and don't need to be set manually.
#
# To run the app locally (npm run start:dev) against `docker compose up floci`,
# copy this file to .env and keep these values.
#
# In production, remove AWS_ENDPOINT_URL entirely so the AWS SDK talks to
# real AWS, and provide real credentials (or rely on the environment's
# default IAM credential chain instead of static keys).
AWS_ENDPOINT_URL=http://localhost:4566
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SECRETS_MANAGER_SECRET_ID=app/database

# --- Observability (@nestjs/observe) ---
# https://observe.nestjs.com — sign up and create a service; the dashboard
# issues appKey/appSecret together (secret shown once, not retrievable
# afterwards). Free for up to 300,000 events/month.
#
# Left empty, the app still runs fine — the collector just answers 401 and
# telemetry is dropped, so this is entirely optional for local dev.
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
OBSERVE_SERVICE_ID=nestjs-app
